{
  "name": "graphloom",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/ensure-deps.cjs",
    "dev": "node node_modules/next/dist/bin/next dev --turbopack",
    "prebuild": "node scripts/ensure-deps.cjs",
    "build": "node node_modules/next/dist/bin/next build --webpack",
    "build:turbo": "node node_modules/next/dist/bin/next build --turbopack",
    "prestart": "node scripts/ensure-deps.cjs",
    "start": "node node_modules/next/dist/bin/next start",
    "lint": "node node_modules/eslint/bin/eslint.js .",
    "postinstall": "node -e \"try{require('child_process').execSync('npm rebuild better-sqlite3',{stdio:'inherit'})}catch(e){console.warn('better-sqlite3 rebuild skipped:', e.message)}\""
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "cytoscape": "^3.34.0",
    "jose": "^6.2.8",
    "lucide-react": "^1.30.0",
    "next": "^16.3.0",
    "papaparse": "^5.5.4",
    "react": "^19.0.0",
    "react-cytoscapejs": "^2.0.0",
    "react-dom": "^19.0.0",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cytoscape": "^3.21.9",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "eslint": "^9",
    "eslint-config-next": "^16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
